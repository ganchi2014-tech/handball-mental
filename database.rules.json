{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('coaches').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('coaches').child(auth.uid).exists())",
        "state": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "gameStats": {
          ".write": "auth != null && (auth.uid === $uid || root.child('coaches').child(auth.uid).exists())"
        },
        "coachNotes": {
          ".write": "auth != null && root.child('coaches').child(auth.uid).exists()"
        },
        "consultAck": {
          ".write": "auth != null && root.child('coaches').child(auth.uid).exists()"
        }
      }
    },

    "coaches": {
      ".read": "auth != null",
      ".write": false
    },

    "staff": {
      ".read": "auth != null",
      ".write": false
    },

    "physicals": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('coaches').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('coaches').child(auth.uid).exists() || root.child('staff').child(auth.uid).exists())"
      }
    },

    "team": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('coaches').child(auth.uid).exists()",
      "tryNow": {
        ".write": "auth != null && (root.child('coaches').child(auth.uid).exists() || root.child('team').child('boardKeeperUid').val() === auth.uid)"
      }
    },

    "roster": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('coaches').child(auth.uid).exists()"
    },

    "rosterToUid": {
      ".read": "auth != null",
      "$rid": {
        ".write": "auth != null && (newData.val() === auth.uid || root.child('coaches').child(auth.uid).exists())"
      }
    },

    "matches": {
      ".read": "auth != null && root.child('coaches').child(auth.uid).exists()",
      ".write": "auth != null"
    },

    "lab": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('labLinks').child(auth.uid).child('labUid').val() === $uid)",
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    "labLinks": {
      "$mentalUid": {
        ".read": "auth != null && (auth.uid === $mentalUid || data.child('labUid').val() === auth.uid)",
        ".write": "auth != null && ((newData.exists() && newData.child('labUid').val() === auth.uid && newData.child('rosterId').isString() && (!data.exists() || data.child('labUid').val() === auth.uid)) || (!newData.exists() && data.exists() && (data.child('labUid').val() === auth.uid || auth.uid === $mentalUid)))",
        ".validate": "!newData.exists() || newData.hasChildren(['labUid', 'rosterId'])"
      }
    },

    "labShared": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('author').val() === auth.uid) || (data.exists() && data.child('author').val() === auth.uid && (!newData.exists() || newData.child('author').val() === auth.uid)))"
      }
    }
  }
}
